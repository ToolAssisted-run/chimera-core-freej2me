  {
   "name": "customSoundfont",
   "display": "setting.customsoundfont",
   "type": "bool",
   "default": false,
   "description": "setting.customsoundfont.about"
  }
 ],
 "firmware": [
  {
   "id": "soundfont.sf2",
   "display": "firmware.soundfont_sf2",
   "name": "soundfont.sf2",
   "description": "firmware.soundfont_sf2.about",
   "requiredWhen": {
    "setting": "customSoundfont",
    "is": true
   }
  }
 ],
 "extensions": {
  ".jar": "J2ME",
  ".jad": "J2ME",
  ".kjx": "J2ME"
 },
 "input": {
  "name": "J2ME Controls",
  "_comment": "A phone's keys: the arrows, Fire (the middle of the arrows), the two soft keys under the screen, the number keys with Star and Pound, and Clear. Touch is the touch screen held; where it is held is Touch X and Touch Y, each a fraction of the picture from 0 to 65535 (0 is the left or top edge). Which code each key sends is the Phone Keys setting.",
  "buttons": [
   "Up",
   "Down",
   "Left",
   "Right",
   "Fire",
   "Left Soft",
   "Right Soft",
   "Num 1",
   "Num 2",
   "Num 3",
   "Num 4",
   "Num 5",
   "Num 6",
   "Num 7",
   "Num 8",
   "Num 9",
   "Star",
   "Num 0",
   "Pound",
   "Clear",
   "Touch"
  ],
  "mnemonics": {
   "Up": "U",
   "Down": "D",
   "Left": "L",
   "Right": "R",
   "Fire": "F",
   "Left Soft": "[",
   "Right Soft": "]",
   "Num 1": "1",
   "Num 2": "2",
   "Num 3": "3",
   "Num 4": "4",
   "Num 5": "5",
   "Num 6": "6",
   "Num 7": "7",
   "Num 8": "8",
   "Num 9": "9",
   "Star": "*",
   "Num 0": "0",
   "Pound": "#",
   "Clear": "C",
   "Touch": "T"
  },
  "axes": [
   {
    "name": "Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "TX"
   },
   {
    "name": "Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "TY"
   }
  ]
 }
}
