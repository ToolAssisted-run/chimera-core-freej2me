{
 "coreName": "FreeJ2ME-Plus",
 "systemId": "J2ME",
 "systemNames": {
  "J2ME": "J2ME (Java phones)"
 },
 "author": "David Richardson (recompile), the FreeJ2ME-Plus authors (TASEmulators); chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-freej2me",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  64,
  4,
  16,
  4,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. The Java VM keeps its heap (64 MB at most), its classes and its threads' stacks in the mmap part; the invisible part holds the picture.",
 "video": {
  "_comment": "The phone's screen, the size the Screen Size setting says (240x320 unless set), with square pixels. The core says the size every frame. 60 frames a second: a frame is 1/60 s of the phone's time.",
  "width": 240,
  "height": 320,
  "virtualWidth": 240,
  "virtualHeight": 320,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "Everything the game plays - MIDI music through the JDK's synthesizer, sampled sound - mixed to stereo at 44100 samples a second: 735 a frame.",
  "rate": 44100,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "screenSize",
   "display": "Screen Size",
   "type": "enum",
   "options": [
    "96x65",
    "101x64",
    "101x80",
    "128x128",
    "130x130",
    "120x160",
    "128x160",
    "132x176",
    "176x208",
    "176x220",
    "208x208",
    "220x176",
    "240x240",
    "240x320",
    "320x240",
    "240x400",
    "400x240",
    "240x432",
    "240x480",
    "352x416",
    "360x360",
    "360x640",
    "640x360",
    "480x800",
    "800x480"
   ],
   "default": "240x320",
   "description": "The phone's screen, in pixels, width by height. A J2ME game draws for the screen it is given; many were made for one size and draw only part of a larger screen. 240x320 is the most common. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "phone",
   "display": "Phone Keys",
   "type": "enum",
   "options": [
    "Standard",
    "LG",
    "Motorola",
    "MotoTriplets",
    "MotoV8",
    "MotoA1000",
    "NokiaKeyboard",
    "Sagem",
    "Siemens",
    "SKT",
    "KDDI",
    "BlackBerry89"
   ],
   "default": "Standard",
   "description": "Which maker's key codes the keys send. Phones of different makers numbered the arrows and the soft keys differently, and a game made for one reads those numbers. 'Standard' is Nokia's, which most games use; choose the maker a game was made for if its keys do nothing. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "fpsLimit",
   "display": "Frame Limit",
   "type": "enum",
   "options": [
    "60",
    "30",
    "20",
    "15",
    "off"
   ],
   "default": "60",
   "description": "The most pictures a second FreeJ2ME lets the game draw, as on a real phone; 'off' lets a game draw as often as it asks. Some games run their logic once per picture drawn and run too fast with no limit. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "sound",
   "display": "Sound",
   "type": "enum",
   "options": [
    "on",
    "off"
   ],
   "default": "on",
   "description": "'off' gives the game no sound at all: its players start and play silence. A game may behave differently without sound (one that waits for a tune to end), so this is part of the machine, and a movie needs the same value."
  },
  {
   "name": "midiSynths",
   "display": "MIDI Synthesizers",
   "type": "enum",
   "options": [
    "1",
    "2",
    "3",
    "4"
   ],
   "default": "4",
   "description": "How many MIDI tunes can play at once, each on a synthesizer of its own (FreeJ2ME's own setting). More cost more time a frame. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "textEncoding",
   "display": "Text Encoding",
   "type": "enum",
   "options": [
    "auto",
    "ISO_8859_1",
    "Shift_JIS",
    "EUC_KR"
   ],
   "default": "auto",
   "description": "How the game's text is read. 'auto' is what FreeJ2ME chooses: Korean (EUC_KR) for an SKT game (.msd beside it), Japanese (Shift_JIS) for a KDDI game (.kjx) or with a DoJa descriptor (.jam) beside it, else ISO_8859_1. A game that asks for another one than it was started with is not started, and says which to choose here. It is part of the machine, so a movie needs the same value."
  }
 ],
 "firmware": [],
 "extensions": {
  ".jar": "J2ME",
  ".jad": "J2ME",
  ".kjx": "J2ME"
 },
 "input": {
  "name": "J2ME Controls",
  "_comment": "A phone's keys: the arrows, Fire (the middle of the arrows), the two soft keys under the screen, the number keys with Star and Pound, and Clear. Touch is the touch screen held; where it is held is Touch X and Touch Y, each a fraction of the picture from 0 to 65535 (0 is the left or top edge). Which code each key sends is the Phone Keys setting.",
  "buttons": [
   "Up",
   "Down",
   "Left",
   "Right",
   "Fire",
   "Left Soft",
   "Right Soft",
   "Num 1",
   "Num 2",
   "Num 3",
   "Num 4",
   "Num 5",
   "Num 6",
   "Num 7",
   "Num 8",
   "Num 9",
   "Star",
   "Num 0",
   "Pound",
   "Clear",
   "Touch"
  ],
  "mnemonics": {
   "Up": "U",
   "Down": "D",
   "Left": "L",
   "Right": "R",
   "Fire": "F",
   "Left Soft": "[",
   "Right Soft": "]",
   "Num 1": "1",
   "Num 2": "2",
   "Num 3": "3",
   "Num 4": "4",
   "Num 5": "5",
   "Num 6": "6",
   "Num 7": "7",
   "Num 8": "8",
   "Num 9": "9",
   "Star": "*",
   "Num 0": "0",
   "Pound": "#",
   "Clear": "C",
   "Touch": "T"
  },
  "axes": [
   {
    "name": "Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "TX"
   },
   {
    "name": "Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "TY"
   }
  ]
 }
}
