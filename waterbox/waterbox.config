  },
  {
   "name": "compatRepaintOnSetCurrent",
   "display": "setting.compatrepaintonsetcurrent",
   "type": "bool",
   "default": false,
   "description": "setting.compatrepaintonsetcurrent.about"
  },
  {
   "name": "compatNoTranslateDrawRGB",
