    "Shift_JIS",
    "EUC_KR",
    "GBK",
    "Big5"
   ],
   "default": "auto",
   "description": "setting.textencoding.about"
  },
  {
   "name": "compatFantasyZoneFix",
   "display": "setting.compatfantasyzonefix",
   "type": "bool",
