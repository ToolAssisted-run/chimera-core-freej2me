  {
   "name": "sound",
   "display": "setting.sound",
   "type": "enum",
   "options": [
    "on",
    "off"
   ],
   "default": "on",
   "description": "setting.sound.about"
  },
  {
   "name": "midiSynths",
   "display": "setting.midisynths",
