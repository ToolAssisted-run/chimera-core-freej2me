{
 "coreName": "FreeJ2ME-Plus",
 "systemId": "J2ME",
 "systemNames": {
  "J2ME": "J2ME (Java phones)"
 },
 "author": "David Richardson (recompile), the FreeJ2ME-Plus authors (TASEmulators); chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-freej2me",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  64,
  4,
  16,
  4,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. The Java VM keeps its heap (64 MB at most), its classes and its threads' stacks in the mmap part; the invisible part holds the picture.",
 "video": {
  "_comment": "The phone's screen, the size the Screen Size setting says (240x320 unless set), with square pixels. The core says the size every frame, and the width and height here are the room for the largest (480x800 and 800x480): a picture bigger than the room declared is cut to it (chimera#303). No virtual size: with square pixels the picture is its own shape, upright or on its side. 60 frames a second: a frame is 1/60 s of the phone's time.",
  "width": 800,
  "height": 800,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "Everything the game plays - MIDI music through the JDK's synthesizer, sampled sound - mixed to stereo at 44100 samples a second: 735 a frame.",
  "rate": 44100,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "screenSize",
   "display": "setting.screensize",
   "type": "enum",
   "options": [
    "96x65",
    "101x64",
    "101x80",
    "128x128",
