 	public static final int getMobileKey(int keycode)
 	{
+		// Send, the phone call key (chimera core: key 23, which FreeJ2ME has no use for: its 20 to 22 are the
+		// fast forward, rotate and pause hotkeys). Upstream defines a Send code for two of the phone mappings:
+		// Nokia, which is also what every mapping without a code of its own gets (NOKIA_SEND, -10), and SKT
+		// (Canvas.KEY_CALL, 190). MotoA1000 uses -10 for its left soft key, so it sends nothing (0) rather than a
+		// second key with that code. Nothing else here maps to getGameAction, so a game gets no action from it.
+		if(keycode == 23)
+		{
+			if(skt) { return Canvas.KEY_CALL; }
+			if(motoA1000) { return 0; }
+			return NOKIA_SEND;
+		}
