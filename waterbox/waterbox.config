   "display": "setting.m3gperspectivecorrection",
   "type": "enum",
   "options": [
    "off",
    "app",
    "on"
   ],
   "optionLabels": {
    "off": "setting.m3gperspectivecorrection.option.off",
    "app": "setting.m3gperspectivecorrection.option.app",
    "on": "setting.m3gperspectivecorrection.option.on"
   },
   "default": "app",
   "description": "setting.m3gperspectivecorrection.about"
  },
  {
