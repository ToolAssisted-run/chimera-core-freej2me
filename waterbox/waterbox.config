    "high": "setting.m3gperspectivequality.option.high",
    "medium": "setting.m3gperspectivequality.option.medium",
    "low": "setting.m3gperspectivequality.option.low"
   },
   "default": "high",
   "description": "setting.m3gperspectivequality.about"
  },
  {
   "name": "dojaVersion",
   "display": "setting.dojaversion",
   "type": "enum",
   "options": [
    "10",
    "20",
    "30",
    "35",
    "40",
    "41",
    "50",
    "51",
    "100",
    "110",
    "120",
    "130",
    "150",
    "200"
   ],
   "optionLabels": {
    "10": "setting.dojaversion.option.10",
    "20": "setting.dojaversion.option.20",
    "30": "setting.dojaversion.option.30",
    "35": "setting.dojaversion.option.35",
    "40": "setting.dojaversion.option.40",
    "41": "setting.dojaversion.option.41",
    "50": "setting.dojaversion.option.50",
    "51": "setting.dojaversion.option.51",
    "100": "setting.dojaversion.option.100",
    "110": "setting.dojaversion.option.110",
    "120": "setting.dojaversion.option.120",
    "130": "setting.dojaversion.option.130",
    "150": "setting.dojaversion.option.150",
    "200": "setting.dojaversion.option.200"
   },
   "default": "200",
   "description": "setting.dojaversion.about"
